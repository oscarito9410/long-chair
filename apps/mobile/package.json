    "@expo-google-fonts/caveat": "0.4.2",
    "@expo-google-fonts/nunito": "0.4.2",
    "@expo/metro-runtime": "57.0.16",
    "@long-chair/core": "0.1.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.28",
    "expo-blur": "57.0.3",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.12",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "lucide-react-native": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
